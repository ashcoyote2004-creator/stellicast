# -------- Supabase (required) --------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_API_KEY=

# -------- Video storage (Supabase Storage by default) --------
# Bucket used for videos and thumbnails. Create it in Supabase → Storage and
# make it public so playback and thumbnails can be served.
SUPABASE_STORAGE_BUCKET=videos

# -------- Optional: your own storage API instead of Supabase Storage --------
# Leave these empty to keep using Supabase Storage.
# Setting STORAGE_API_URL switches the app to your own API (STORAGE_PROVIDER=custom
# is implied, but can be set explicitly).
STORAGE_PROVIDER=
STORAGE_API_URL=
STORAGE_API_KEY=
# Public hostname of your CDN, used for next/image optimisation (optional).
STORAGE_CDN_HOSTNAME=

# -------- Site --------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_SITE_URL=https://stellicast.com
RESEND_API_KEY=
SHOW_DEBUG_INFO=false
